# dotfiles-core ghostty config — shared terminal settings.
# Loaded from each machine's ~/.config/ghostty/config via `config-file`. Ghostty
# processes included files AFTER the including file, and later values win — so a
# key set here would silently override the machine layer. Keep the key sets
# disjoint: font-family (and anything machine-specific) must NEVER appear here.

# Auto light/dark switching, tied to macOS appearance, using the
# Zenwritten themes bundled with Ghostty.
theme = dark:Zenwritten Dark,light:Zenwritten Light

font-size = 13
window-padding-x = 10
window-padding-y = 10

# Native titlebar avoids tab bar layout issues on macOS Golden Gate.
macos-titlebar-style = native

cursor-style = block

# Optional translucent background; currently disabled.
# background-opacity = 0.85
# background-blur = true

# Option key sends Alt/Meta instead of composing accented characters —
# needed for terminal programs/shells that expect alt+key bindings.
macos-option-as-alt = true
